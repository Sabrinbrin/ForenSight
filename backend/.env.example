# Local demo API configuration. Never commit a real API key.
FORENSIGHT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FORENSIGHT_MAX_EVENTS=5000
FORENSIGHT_MAX_ARTIFACT_MB=512
# Optional live reasoning. This stays in the local backend, never in the browser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Keep false for a fully local review. Enable only after adding a valid Platform API key.
FORENSIGHT_ENABLE_OPENAI=false
# Optional ElevenLabs evidence-brief narration. Never expose this key to the browser.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Optional hash-only reputation enrichment. Never expose this key to the browser.
VIRUSTOTAL_API_KEY=
